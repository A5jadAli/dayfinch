TRACKER_ADMIN_PASSWORD=replace-with-a-long-random-password
TRACKER_SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes, URL-safe base64 encoded; keep stable to decrypt invoice documents.
TRACKER_DOCUMENT_ENCRYPTION_KEY=replace-with-43-character-base64url-key
POSTGRES_PASSWORD=replace-database-password

# Private S3-compatible screenshot storage (AWS S3, MinIO, R2, Spaces, etc.)
# TRACKER_STORAGE_BACKEND=s3
# TRACKER_S3_BUCKET=dayfinch-private-screenshots
# TRACKER_S3_REGION=us-east-1
# TRACKER_S3_ENDPOINT_URL=
# TRACKER_S3_SSE=AES256
# AWS_ACCESS_KEY_ID=replace-access-key
# AWS_SECRET_ACCESS_KEY=replace-secret-key

# Scheduled report email delivery
# TRACKER_SMTP_HOST=smtp.example.com
# TRACKER_SMTP_PORT=587
# TRACKER_SMTP_USERNAME=dayfinch
# TRACKER_SMTP_PASSWORD=replace-smtp-password
# TRACKER_SMTP_FROM_EMAIL=reports@example.com
# TRACKER_SMTP_STARTTLS=true

# Signed payroll-provider adapter (your Wise/PayPal/bank integration endpoint)
# TRACKER_PAYMENT_WEBHOOK_URL=https://payments.example.com/dayfinch/payroll
# TRACKER_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-signing-secret
