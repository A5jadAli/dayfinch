TRACKER_ADMIN_PASSWORD=replace-with-a-long-random-password
TRACKER_ADMIN_EMAIL=admin@example.com
TRACKER_SESSION_SECRET=replace-with-at-least-32-random-characters
TRACKER_DATA_DIR=./runtime
TRACKER_DATABASE_URL=postgresql://dayfinch:replace-database-password@postgres:5432/dayfinch
TRACKER_DATABASE_MIN_POOL_SIZE=1
TRACKER_DATABASE_MAX_POOL_SIZE=10
POSTGRES_PASSWORD=replace-database-password
TRACKER_COOKIE_SECURE=false
TRACKER_MAX_UPLOAD_MB=15
TRACKER_RETENTION_DAYS=30
TRACKER_INVITATION_HOURS=168

# Use "s3" in production, then set the private bucket details below.
TRACKER_STORAGE_BACKEND=local
TRACKER_S3_BUCKET=
TRACKER_S3_PREFIX=dayfinch/screenshots
TRACKER_S3_REGION=us-east-1
# Optional for MinIO, Cloudflare R2, DigitalOcean Spaces, or another S3-compatible service.
TRACKER_S3_ENDPOINT_URL=
# AES256, aws:kms, or empty to rely on the bucket's default encryption.
TRACKER_S3_SSE=AES256
TRACKER_S3_KMS_KEY_ID=

# Use the standard AWS credential chain. Never commit these values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # only for temporary credentials
