TRACKER_ADMIN_PASSWORD=replace-with-a-long-random-password
TRACKER_ADMIN_EMAIL=admin@example.local
TRACKER_SESSION_SECRET=replace-with-at-least-32-random-characters
TRACKER_ENVIRONMENT=development
TRACKER_PUBLIC_URL=http://127.0.0.1:8000
TRACKER_ALLOWED_HOSTS=127.0.0.1,localhost
TRACKER_COOKIE_SECURE=false
# 32 random bytes, URL-safe base64 encoded; keep stable to decrypt invoice documents.
TRACKER_DOCUMENT_ENCRYPTION_KEY=replace-with-43-character-base64url-key
# Primary key first, followed by any decryption-only previous keys. Each value
# must decode to 32 bytes. Keep old keys until all provider rows are rewrapped.
# TRACKER_INTEGRATION_ENCRYPTION_KEYS=2026-09:base64url-32-byte-key,2026-06:previous-key
# A separate 32-byte base64url key for authenticated database/object backups.
# Escrow it outside the deployment; losing it makes backups unrecoverable.
TRACKER_BACKUP_ENCRYPTION_KEY=replace-with-a-different-43-character-base64url-key
POSTGRES_PASSWORD=replace-database-password
# Security/administrative audit events default to seven years (2555 days).
# TRACKER_AUDIT_RETENTION_DAYS=2555

# Distributed login throttling (shared through PostgreSQL across server replicas)
# TRACKER_LOGIN_WINDOW_MINUTES=15
# TRACKER_LOGIN_IDENTITY_FAILURE_LIMIT=8
# TRACKER_LOGIN_SOURCE_FAILURE_LIMIT=50
# Shared PostgreSQL request throttles. Replay has a separate high allowance so an
# agent reconnecting after an outage can flush its encrypted offline queue.
# TRACKER_RATE_LIMIT_WINDOW_SECONDS=60
# TRACKER_ANONYMOUS_REQUEST_LIMIT=120
# TRACKER_WEB_REQUEST_LIMIT=600
# TRACKER_DEVICE_REQUEST_LIMIT=600
# TRACKER_DEVICE_REPLAY_REQUEST_LIMIT=6000
# TRACKER_LOG_LEVEL=INFO
# Set 32+ random characters to expose a bearer-protected /metrics endpoint.
# TRACKER_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Private S3-compatible screenshot storage (AWS S3, MinIO, R2, Spaces, etc.)
# TRACKER_STORAGE_BACKEND=s3
# TRACKER_S3_BUCKET=dayfinch-private-screenshots
# TRACKER_S3_REGION=us-east-1
# TRACKER_S3_ENDPOINT_URL=
# TRACKER_S3_SSE=AES256
# AWS_ACCESS_KEY_ID=replace-access-key
# AWS_SECRET_ACCESS_KEY=replace-secret-key

# Local stand-ins only: compose.local.yaml ignores the S3/SMTP values above and
# uses Mailpit plus MinIO. These optional overrides are intentionally insecure
# development credentials and must never be reused outside a local workstation.
# DAYFINCH_LOCAL_MINIO_USER=dayfinch-local
# DAYFINCH_LOCAL_MINIO_PASSWORD=dayfinch-local-password

# Scheduled report email delivery
# TRACKER_SMTP_HOST=smtp.example.com
# TRACKER_SMTP_PORT=587
# TRACKER_SMTP_USERNAME=dayfinch
# TRACKER_SMTP_PASSWORD=replace-smtp-password
# TRACKER_SMTP_FROM_EMAIL=reports@example.com
# TRACKER_SMTP_STARTTLS=true
# TRACKER_SMTP_TIMEOUT_SECONDS=10

# OpenID Connect SSO (the callback is TRACKER_PUBLIC_URL/auth/oidc/callback)
# TRACKER_OIDC_ISSUER=https://id.example.com
# TRACKER_OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# TRACKER_OIDC_CLIENT_ID=dayfinch
# TRACKER_OIDC_CLIENT_SECRET=replace-oidc-client-secret
# TRACKER_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# Optional provider end_session_endpoint for RP-initiated logout.
# TRACKER_OIDC_END_SESSION_URL=https://id.example.com/oidc/logout

# SAML 2.0 SSO (the ACS is TRACKER_PUBLIC_URL/auth/saml/acs)
# Use base64 without line wrapping. IdP metadata is pinned locally and never fetched
# from a user-supplied URL. The SP key must be unencrypted RSA 2048-bit or stronger.
# TRACKER_SAML_IDP_ENTITY_ID=https://id.example.com/saml/metadata
# TRACKER_SAML_IDP_METADATA_B64=base64-encoded-idp-metadata-xml
# TRACKER_SAML_SP_PRIVATE_KEY_B64=base64-encoded-pem-private-key
# TRACKER_SAML_SP_CERTIFICATE_B64=base64-encoded-pem-certificate
# TRACKER_SAML_EMAIL_ATTRIBUTE=email
# TRACKER_SCIM_BEARER_TOKEN=replace-with-at-least-32-random-characters

# GitHub App issue synchronization. Configure the app with:
# Setup URL: https://tracker.example.com/integrations/github/setup
# Callback URL: https://tracker.example.com/integrations/github/callback
# Webhook URL: https://tracker.example.com/integrations/github/webhook
# Permissions: Metadata read, Issues read. Events: Issues, Installation,
# Installation repositories. Keep the PEM key in a secret manager and base64 it
# as one uninterrupted value for the container environment.
# TRACKER_GITHUB_APP_SLUG=your-dayfinch-app
# TRACKER_GITHUB_CLIENT_ID=Iv23li...
# TRACKER_GITHUB_CLIENT_SECRET=replace-github-client-secret
# TRACKER_GITHUB_PRIVATE_KEY_B64=base64-encoded-pem-private-key
# TRACKER_GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# TRACKER_GITHUB_API_URL=https://api.github.com
# TRACKER_GITHUB_WEB_URL=https://github.com
# TRACKER_GITHUB_API_VERSION=2026-03-10

# Jira Cloud OAuth 2.0 (3LO). Callback URL:
# https://tracker.example.com/integrations/jira/callback
# Configure classic read:jira-work plus offline_access scopes. The encrypted
# rotating refresh token requires TRACKER_INTEGRATION_ENCRYPTION_KEYS above.
# TRACKER_JIRA_CLIENT_ID=replace-atlassian-oauth-client-id
# TRACKER_JIRA_CLIENT_SECRET=replace-atlassian-oauth-client-secret
# TRACKER_JIRA_AUTHORIZE_URL=https://auth.atlassian.com/authorize
# TRACKER_JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
# TRACKER_JIRA_API_URL=https://api.atlassian.com

# Asana OAuth imports mapped project tasks and attributes tracked time comments to
# each linked employee. Register the callback URL shown in organization settings.
# Required scopes: openid profile email workspaces:read projects:read
# tasks:read stories:read stories:write.
# TRACKER_ASANA_CLIENT_ID=replace-asana-oauth-client-id
# TRACKER_ASANA_CLIENT_SECRET=replace-asana-oauth-client-secret
# TRACKER_ASANA_AUTHORIZE_URL=https://app.asana.com/-/oauth_authorize
# TRACKER_ASANA_TOKEN_URL=https://app.asana.com/-/oauth_token
# TRACKER_ASANA_TOKEN_INFO_URL=https://app.asana.com/-/token_info
# TRACKER_ASANA_REVOKE_URL=https://app.asana.com/-/oauth_revoke
# TRACKER_ASANA_API_URL=https://app.asana.com/api/1.0

# Slack timer and completed-to-do notifications. Callback URL:
# https://tracker.example.com/integrations/slack/callback
# Bot scopes: chat:write,chat:write.public,channels:read,groups:read,users:read.
# Invite the Dayfinch bot to every selected private channel.
# TRACKER_SLACK_CLIENT_ID=replace-slack-client-id
# TRACKER_SLACK_CLIENT_SECRET=replace-slack-client-secret
# TRACKER_SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
# TRACKER_SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
# TRACKER_SLACK_API_URL=https://slack.com/api

# HTTPS links to operator-signed desktop packages shown after device enrollment
# TRACKER_AGENT_WINDOWS_URL=https://downloads.example.com/dayfinch-agent-windows-x64.exe
# TRACKER_AGENT_MACOS_URL=https://downloads.example.com/dayfinch-agent-macos-arm64.pkg
# TRACKER_AGENT_LINUX_URL=https://downloads.example.com/dayfinch-agent-linux-amd64.deb
# Ed25519-authenticated release channel embedded into newly enrolled agent.toml files.
# The public key is produced beside the manifest by scripts/sign_update_manifest.py.
# TRACKER_AGENT_UPDATE_MANIFEST_URL=https://downloads.example.com/dayfinch-update.json
# TRACKER_AGENT_UPDATE_PUBLIC_KEY=replace-with-base64url-ed25519-public-key

# Payroll delivery: manual, webhook, paypal, or wise. Direct providers start in
# sandbox unless their API URL is explicitly changed to the live origin.
# TRACKER_PAYMENT_PROVIDER=paypal
# TRACKER_PAYPAL_CLIENT_ID=paypal-client-id
# TRACKER_PAYPAL_CLIENT_SECRET=paypal-client-secret
# TRACKER_PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# TRACKER_PAYMENT_PROVIDER=wise
# TRACKER_WISE_API_TOKEN=replace-with-wise-api-token
# TRACKER_WISE_PROFILE_ID=12345678
# TRACKER_WISE_BALANCE_ID=87654321
# TRACKER_WISE_SOURCE_CURRENCY=USD
# TRACKER_WISE_API_URL=https://api.wise-sandbox.com/2026Q3
# In Wise Developer Hub, create three profile/application subscriptions using
# schema 4.0.0 and this callback URL:
# https://tracker.example.com/api/v1/payroll/wise-webhook
# Event types: transfers#state-change, transfers#payout-failure, transfers#refund
# Dayfinch selects Wise's documented sandbox/live RSA key from the API URL.
# Override only for an announced Wise key rotation or a controlled test key by
# base64-encoding the complete PEM public key:
# TRACKER_WISE_WEBHOOK_PUBLIC_KEY_B64=

# Signed custom payroll-provider adapter (alternative to the direct connector)
# TRACKER_PAYMENT_PROVIDER=webhook
# TRACKER_PAYMENT_WEBHOOK_URL=https://payments.example.com/dayfinch/payroll
# TRACKER_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-signing-secret
