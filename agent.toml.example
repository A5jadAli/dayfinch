# Copy this file to agent.toml on the tracked device.
server_url = "http://127.0.0.1:8000"
device_token = "paste-the-one-time-enrollment-token-here"

# The employee/device owner must review the disclosure and explicitly change this.
consent_confirmed = false
# Optional task UUID from the assigned project page. Leave empty for general
# project time; changing it starts a new work session on the next heartbeat.
task_id = ""

capture_interval_seconds = 600
heartbeat_interval_seconds = 60
jpeg_quality = 65
capture_all_monitors = true

# Longest screenshot edge in pixels. Captures are shrunk by a whole-number factor
# before encoding, which keeps the agent light on older or busy machines and cuts
# upload size sharply on 4K and multi-monitor desktops. Set 0 to keep full size.
max_image_dimension = 1920

# After this many seconds with no OS session input the current work segment is
# backdated to the last input, so the whole idle stretch is removed. Set 0 to disable.
idle_timeout_seconds = 1800

# Record the domain (host only, never the full URL or page title) of the foreground
# browser tab. Chromium on Linux/Windows uses the extension in extensions/chromium.
collect_websites = true
website_bridge_token = ""
website_bridge_port = 8765

max_queue_items = 500
queue_dir = "./runtime/agent-queue"
